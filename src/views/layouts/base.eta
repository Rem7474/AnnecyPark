<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light dark">
  <script nonce="<%= it.nonce %>">try{var s=localStorage.getItem('color-scheme');if(s==='light'||s==='dark'){document.querySelector('meta[name="color-scheme"]').content=s;}}catch(e){}</script>
  <meta name="text-scale" content="scale">
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#FFFFFF">
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#14171A">
  <title><%= it.title %></title>
  <meta name="description" content="<%= it.metaDescription %>">
  <meta name="robots" content="<%= it.robotsDirective || 'index, follow' %>">
  <% if (it.canonicalUrl) { %>
  <link rel="canonical" href="<%= it.canonicalUrl %>">
  <% } %>

  <meta property="og:type" content="<%= it.ogType || 'website' %>">
  <meta property="og:site_name" content="AnnecyPark">
  <meta property="og:title" content="<%= it.ogTitle || it.title %>">
  <meta property="og:description" content="<%= it.metaDescription %>">
  <% if (it.canonicalUrl) { %>
  <meta property="og:url" content="<%= it.canonicalUrl %>">
  <% } %>
  <meta property="og:image" content="<%= it.baseUrl %>/og-image.png">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="<%= it.ogImageAlt || it.title %>">
  <meta property="og:locale" content="fr_FR">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= it.ogTitle || it.title %>">
  <meta name="twitter:description" content="<%= it.metaDescription %>">
  <meta name="twitter:image" content="<%= it.baseUrl %>/og-image.png">
  <meta name="twitter:image:alt" content="<%= it.ogImageAlt || it.title %>">

  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="48x48" href="/icons/favicon-48.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">

  <% if (it.assets && it.assets.preloadFonts) { %>
    <% it.assets.preloadFonts.forEach((fontHref) => { %>
  <link rel="preload" as="font" type="font/woff2" crossorigin href="<%= fontHref %>">
    <% }) %>
  <% } %>
  <% if (it.assets && it.assets.css) { %>
    <% it.assets.css.forEach((cssHref) => { %>
  <link rel="stylesheet" href="<%= cssHref %>">
    <% }) %>
  <% } %>
  <% if (it.jsonLd) { %>
  <script type="application/ld+json"><%~ it.safeJsonLd(it.jsonLd) %></script>
  <% } %>
</head>
<body>
  <a class="skip-link" href="#main-content">Aller au contenu principal</a>

  <header class="site-header">
    <div class="site-header-inner">
      <a class="brand-link" href="/">AnnecyPark</a>

      <nav class="main-nav" aria-label="Principale">
        <a href="/#live-section" data-nav-target="live-section"<% if (it.pageType === 'home') { %> aria-current="location"<% } %>>Temps réel</a>
        <a href="/#analytics-section" data-nav-target="analytics-section">Prévisions</a>
        <a href="/#guide-section" data-nav-target="guide-section">Guide</a>
      </nav>

      <div class="header-actions">
        <div class="freshness-pill" id="freshnessPill" data-state="<%= it.snapshot && it.snapshot.stale ? 'stale' : 'live' %>">
          <span class="freshness-dot" aria-hidden="true"></span>
          <span id="freshnessLabel"><%= it.snapshot && it.snapshot.stale ? 'Relevé mémorisé' : 'En direct' %></span>
          <span aria-hidden="true">·</span>
          <time id="lastUpdateTime" datetime="<%= it.snapshot && it.snapshot.timestamp ? it.snapshot.timestamp : '' %>"><%= it.snapshot && it.snapshot.parisTime ? it.snapshot.parisTime : '--:--:--' %></time>
        </div>

        <button type="button" class="theme-toggle" id="themeToggleBtn">
          <span class="sr-only">Passer au thème </span>
          <span class="theme-label-dark">Sombre</span>
          <span class="theme-label-light">Clair</span>
        </button>
      </div>
    </div>

    <div class="connection-banner" id="connectionBanner" role="status" aria-live="polite" hidden>
      <p id="connectionBannerText"></p>
      <button type="button" class="btn-inline" id="retryFetchBtn">Actualiser</button>
    </div>
  </header>

  <main id="main-content" class="page-shell">
    <%~ it.body %>
  </main>

  <footer class="site-footer">
    <div class="site-footer-inner">
      <div class="footer-col">
        <p class="footer-title">AnnecyPark</p>
        <p class="footer-copy">Disponibilité en direct, historique et prévisions des parkings du centre-ville d’Annecy.</p>
      </div>

      <div class="footer-col">
        <p class="footer-heading">Fiches parkings</p>
        <ul class="footer-links">
          <% (it.allParkings || []).forEach((p) => { %>
          <li><a href="/parking/<%= p.slug %>"><%= p.name %></a></li>
          <% }) %>
        </ul>
      </div>

      <div class="footer-col">
        <p class="footer-heading">Sources</p>
        <p class="footer-copy">Temps réel : Grand Annecy Mobilités &amp; NEXTENEO (bornes EV IRVE). Données parkings : Ville d’Annecy (data.gouv.fr). Vacances &amp; fériés : Éducation nationale &amp; api.gouv.fr. Météo : Open-Meteo.</p>
      </div>
    </div>
  </footer>

  <% if (it.bootstrapStateJson) { %>
  <script type="application/json" id="annecypark-state"><%~ it.bootstrapStateJson %></script>
  <% } %>
  <% if (it.assets && it.assets.js) { %>
  <script type="module" nonce="<%= it.nonce %>" src="<%= it.assets.js %>"></script>
  <% } %>
</body>
</html>
